{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree:*)",
      "Bash(git push -u:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue:*)",
      "Bash(gh run:*)",
      "Bash(gh label:*)",
      "Bash(./scripts/*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "g=\"$CLAUDE_PROJECT_DIR/scripts/agent_hooks/block_unsafe_git.py\"; [ -f \"$g\" ] || { echo \"guard missing: $g (fail-closed)\" >&2; exit 2; }; exec python3 \"$g\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
